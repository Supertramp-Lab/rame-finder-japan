{
  "redirects": [
    { "source": "/", "destination": "/en/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/en/:path*", "destination": "/index.html" },
    { "source": "/ja/:path*", "destination": "/index.html" },
    { "source": "/zh-TW/:path*", "destination": "/index.html" },
    { "source": "/zh-CN/:path*", "destination": "/index.html" },
    { "source": "/ko/:path*", "destination": "/index.html" }
  ]
}